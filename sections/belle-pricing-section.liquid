{% comment %}
  Belle's Performance Tennis — Pricing Section
  v5.1 — July 2026
  Block order (updated 2026-08-23):
    1. Hero: price anchor + checkmarks + CTA
    2. Turnaround tier cards
    3. Detailed pricing table

  This page leads with numbers. The explanatory blocks (Not sure what
  string, What You're Paying For, What happens to your racquet) were moved
  out to sections/belle-pricing-explainers.liquid on 2026-08-23 so they
  render below the table AND below the add-ons section. Shopify sections
  are atomic, so that was the only way to get add-ons directly under this
  table. See page.pricing.json for the full page order.

  The old in-section bottom CTA was removed: it sat between the two price
  tables. The page opens with the hero CTA and closes with cta-inline.
{% endcomment %}

<style>
  .bp-pricing {
    --bp-green: #1a3c2a;
    --bp-gold: #c8a951;
    --bp-border: #e5e5e5;
    --bp-text: #1a1a1a;
    --bp-muted: #666;
    --bp-bg: #faf9f6;
    --bp-white: #ffffff;
    --bp-light-green: #f4f8f5;
    font-family: 'Source Sans Pro', sans-serif;
    padding: 40px 20px;
    background: var(--bp-bg);
  }

  .bp-container {
    max-width: 860px;
    margin: 0 auto;
  }

  /* ── 1. HERO ── */
  .bp-hero {
    text-align: center;
    margin-bottom: 32px;
  }

  /* SEO h1 — in DOM for search, visually secondary */
  .bp-hero h1 {
    font-size: 13px;
    font-weight: 400;
    color: var(--bp-muted);
    letter-spacing: 0.03em;
    margin: 0 0 14px;
    font-family: 'Source Sans Pro', sans-serif;
  }

  /* Hook question — leads the eye */
  .bp-hero-hook {
    font-size: 22px;
    font-weight: 700;
    color: var(--bp-text);
    margin: 0 0 16px;
    line-height: 1.3;
  }

  /* Price card — dark green, high contrast */
  .bp-price-card {
    background: var(--bp-green);
    border-radius: 12px;
    padding: 28px 24px 22px;
    margin-bottom: 14px;
  }

  .bp-price-eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bp-gold);
    margin: 0 0 2px;
    opacity: 0.9;
  }

  /* THE number — 2x everything else */
  .bp-price-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 80px;
    color: #ffffff;
    margin: 0 0 2px;
    line-height: 1;
    letter-spacing: 1px;
  }

  .bp-price-suffix {
    font-size: 14px;
    color: rgba(255,255,255,0.65);
    margin: 0 0 20px;
    letter-spacing: 0.02em;
  }

  /* Compressed single-line bullets inside card */
  .bp-hero-checks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin-bottom: 20px;
  }

  .bp-hero-check {
    font-size: 13px;
    color: rgba(255,255,255,0.85);
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .bp-hero-check svg {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--bp-gold);
  }

  /* CTA inside card — gold */
  .bp-cta-gold {
    display: block;
    background: var(--bp-gold);
    color: var(--bp-green);
    text-align: center;
    padding: 15px;
    border-radius: 8px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    letter-spacing: 1.5px;
    text-decoration: none;
    font-weight: 400;
    transition: opacity 0.15s;
  }

  .bp-cta-gold:hover {
    opacity: 0.88;
    color: var(--bp-green);
  }

  /* Northland tagline — below card, smaller */
  .bp-hero-tagline {
    font-size: 13px;
    color: var(--bp-muted);
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
    font-style: italic;
  }

  /* CTA */
  .bp-cta {
    display: block;
    background: var(--bp-green);
    color: var(--bp-gold);
    text-align: center;
    padding: 15px;
    border-radius: 8px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    letter-spacing: 1.5px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .bp-cta:hover {
    opacity: 0.88;
    color: var(--bp-gold);
  }

  /* ── 2. TURNAROUND TIERS ── */
  .bp-tiers-heading {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 26px;
    font-weight: 400;
    color: var(--bp-green);
    margin: 0 0 14px;
    letter-spacing: 1px;
  }

  .bp-tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 32px;
  }

  .bp-tier-card {
    background: var(--bp-white);
    border: 1px solid var(--bp-border);
    border-radius: 12px;
    padding: 20px 18px;
  }

  .bp-tier-card--featured {
    border: 2px solid var(--bp-green);
    background: var(--bp-light-green);
  }

  .bp-tier-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--bp-text);
    margin: 0 0 6px;
  }

  .bp-tier-price {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 32px;
    color: var(--bp-green);
    margin: 0 0 4px;
    line-height: 1.1;
  }

  /* "Starting at" label — half the price size */
  .bp-tier-price-label {
    font-size: 16px;
    display: block;
    letter-spacing: 0.5px;
  }

  .bp-tier-tagline {
    font-size: 13px;
    color: var(--bp-muted);
    margin: 0 0 10px;
  }

  .bp-tier-detail {
    font-size: 13px;
    color: var(--bp-muted);
    margin: 0 0 4px;
  }

  .bp-tier-note {
    font-size: 12px;
    color: var(--bp-muted);
    font-style: italic;
    margin: 10px 0 0;
    line-height: 1.5;
    padding-top: 10px;
    border-top: 1px solid var(--bp-border);
  }

  /* ── 4. CUSTOMER EXAMPLES ── */
  .bp-section-label {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bp-muted);
    margin: 0 0 12px;
  }

  /* ── 6. TABLE ── */
  .bp-table-wrap {
    background: var(--bp-white);
    border: 1px solid var(--bp-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 12px;
  }

  .bp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    table-layout: fixed;
  }

  .bp-table thead th {
    background: var(--bp-green);
    color: rgba(255,255,255,0.9);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 10px 14px;
    text-align: left;
  }

  .bp-table thead th:not(:first-child) {
    text-align: center;
    border-left: 1px solid rgba(255,255,255,0.15);
  }

  .bp-table tbody tr {
    border-bottom: 1px solid var(--bp-border);
  }

  .bp-table tbody tr:last-child {
    border-bottom: none;
  }

  .bp-table tbody tr.bp-row-highlight {
    background: var(--bp-light-green);
  }

  .bp-table td {
    padding: 12px 14px;
    color: var(--bp-text);
    vertical-align: middle;
  }

  .bp-table td:not(:first-child) {
    text-align: center;
    border-left: 1px solid var(--bp-border);
    font-weight: 600;
    font-size: 15px;
    color: var(--bp-green);
  }

  .bp-string-plain {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--bp-green);
    margin-bottom: 2px;
  }

  .bp-string-name {
    font-weight: 600;
    color: var(--bp-text);
    margin-bottom: 2px;
  }

  .bp-string-desc {
    font-size: 12px;
    color: var(--bp-muted);
  }

  .bp-turnaround-note {
    font-size: 12px;
    color: var(--bp-muted);
    margin-bottom: 32px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Mobile */

  @media (max-width: 640px) {
  .bp-price-number { font-size: 56px; }

  .bp-hero-hook { font-size: 18px; }

  .bp-hero-checks { flex-direction: column; align-items: center; }

  .bp-tiers {
      grid-template-columns: 1fr;
    }

  .bp-table td,
    .bp-table thead th {
      padding: 10px;
      font-size: 13px;
    }
  }
</style>

<div class="bp-pricing">
  <div class="bp-container">
    <!-- 1. HERO -->
    <div class="bp-hero">
      <h1>{{ section.settings.title }}</h1>

      <p class="bp-hero-hook">Professional racquet stringing with a guaranteed turnaround, documented setup history, and direct communication with the person stringing your racquet.</p>

      <div class="bp-price-card">
        <p class="bp-price-eyebrow">Standard restrings usually run</p>
        <p class="bp-price-number">$40&ndash;$55</p>
        <p class="bp-price-suffix">labor &amp; strings included</p>

        <div class="bp-hero-checks">
          <span class="bp-hero-check">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Common strings in stock
          </span>
          <span class="bp-hero-check">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            2&ndash;3 day turnaround
          </span>
          <span class="bp-hero-check">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            Same-day when available
          </span>
          <span class="bp-hero-check">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            No deposit
          </span>
        </div>

        <a
          href="https://calendly.com/bellesperformancetennis-sales/racquet_service?utm_source=bellesperformancetennis&utm_medium=cta_button&utm_campaign=racquet_stringing&utm_content=pricing_top"
          class="bp-cta-gold"
        >
          Book Appointment
        </a>
      </div>

      <p class="bp-hero-tagline">
        Northland players shouldn&rsquo;t have to drive to Johnson County or leave a racquet at a retail counter just to
        get a quality restring.
      </p>
    </div>


    <!-- 2. TURNAROUND TIERS -->
    <h2 class="bp-tiers-heading">Choose Your Turnaround</h2>
    <div class="bp-tiers">
      <div class="bp-tier-card bp-tier-card--featured">
        <p class="bp-tier-name">Standard Service</p>
        <p class="bp-tier-price"><span class="bp-tier-price-label">Starting at</span>$40</p>
        <p class="bp-tier-tagline">Most popular option</p>
        <p class="bp-tier-detail">2&ndash;3 day turnaround</p>
      </div>

      <div class="bp-tier-card">
        <p class="bp-tier-name">Next-Day Service</p>
        <p class="bp-tier-price"><span class="bp-tier-price-label">Starting at</span>$55</p>
        <p class="bp-tier-tagline">Includes $15 rush fee</p>
        <p class="bp-tier-detail">When schedule allows</p>
      </div>

      <div class="bp-tier-card">
        <p class="bp-tier-name">Same-Day Rush</p>
        <p class="bp-tier-price"><span class="bp-tier-price-label">Starting at</span>$70</p>
        <p class="bp-tier-tagline">Includes $30 rush fee</p>
        <p class="bp-tier-detail">Very limited - when schedule allows</p>
      </div>
    </div>


    <!-- 3. DETAILED PRICING TABLE -->
    <h2 class="bp-section-label">Detailed Pricing</h2>
    <div class="bp-table-wrap">
      <table class="bp-table">
        <thead>
          <tr>
            <th style="width: 44%">String type</th>
            <th>
              Standard<br>
              <span style="font-weight:400;font-size:11px;text-transform:none;letter-spacing:0;">2&ndash;3 days</span>
            </th>
            <th>
              Express<br>
              <span style="font-weight:400;font-size:11px;text-transform:none;letter-spacing:0;">next day</span>
            </th>
            <th>
              Rush<br>
              <span style="font-weight:400;font-size:11px;text-transform:none;letter-spacing:0;">same day</span>
            </th>
          </tr>
        </thead>
        <tbody>
          <tr class="bp-row-highlight">
            <td>
              <div class="bp-string-plain">All-around, easy choice</div>
              <div class="bp-string-name">Synthetic gut</div>
              <div class="bp-string-desc">Durable, comfortable feel</div>
            </td>
            <td>$40</td>
            <td>$55</td>
            <td>$70</td>
          </tr>
          <tr>
            <td>
              <div class="bp-string-plain">Easier on your arm</div>
              <div class="bp-string-name">Multifilament</div>
              <div class="bp-string-desc">Softer feel, good for sensitive elbows</div>
            </td>
            <td>$50</td>
            <td>$65</td>
            <td>$80</td>
          </tr>
          <tr class="bp-row-highlight">
            <td>
              <div class="bp-string-plain">More spin and control</div>
              <div class="bp-string-name">Polyester</div>
              <div class="bp-string-desc">Solinco Hyper-G, Tour Bite, Confidential &amp; more</div>
            </td>
            <td>$55</td>
            <td>$70</td>
            <td>$85</td>
          </tr>
          <tr>
            <td>
              <div class="bp-string-plain">Best feel and power</div>
              <div class="bp-string-name">Natural gut</div>
              <div class="bp-string-desc">Quoted by string. Ask before you book.</div>
            </td>
            <td>$95+</td>
            <td>$110+</td>
            <td>$125+</td>
          </tr>
          <tr class="bp-row-highlight">
            <td>
              <div class="bp-string-plain">You provide the string</div>
              <div class="bp-string-name">Customer-Supplied String</div>
            </td>
            <td>$35</td>
            <td>$50</td>
            <td>$65</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="bp-turnaround-note">
      <span>All prices include labor &amp; string.</span>
      <span>No deposit. Pay when your racquet is ready.</span>
      <span>Express &amp; Rush subject to availability.</span>
      <span>Sales tax applies to the string portion of your order.</span>
      <span>Customer-supplied string is labor only. Natural gut and unusual strings may require a quote after inspection.</span>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Belle's Pricing",
  "tag": "section",
  "class": "belle-pricing-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Page title",
      "default": "Racquet Stringing Prices in the Kansas City Northland"
    }
  ],
  "presets": [
    {
      "name": "Belle's Pricing"
    }
  ]
}
{% endschema %}
