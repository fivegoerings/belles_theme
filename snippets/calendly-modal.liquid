{% comment %}
  Calendly Modal Popup
  Usage: Add data-calendly-modal="true" to any button/link
  Or use any link with href containing calendly.com (auto-converted)
{% endcomment %}

{%- comment -%} Calendly is a third-party booking widget; preconnect is an intentional performance optimization, not a themeable asset {%- endcomment -%}
{% # theme-check-disable RemoteAsset %}
<link rel="preconnect" href="https://assets.calendly.com" crossorigin>
<link rel="preconnect" href="https://calendly.com" crossorigin>
{% # theme-check-enable RemoteAsset %}
<style>
  .calendly-modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    z-index: 9998;
    animation: fadeIn 0.15s ease;
  }

  .calendly-modal-overlay.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .calendly-modal-container {
    position: relative;
    width: 90%;
    max-width: 1000px;
    height: 90vh;
    max-height: 800px;
    background: white;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    overflow: hidden;
    animation: slideUp 0.15s ease;
  }

  .calendly-modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 40px;
    height: 40px;
    background: white;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: all 0.2s ease;
  }

  .calendly-modal-close:hover {
    background: #f5f5f5;
    transform: scale(1.1);
  }

  .calendly-modal-close svg {
    width: 20px;
    height: 20px;
    fill: #333;
  }

  .calendly-modal-iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .calendly-modal-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .calendly-modal-spinner {
    width: 50px;
    height: 50px;
    border: 4px solid #f3f3f3;
    border-top: 4px solid #1e4d2b;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .calendly-modal-container {
      width: 95%;
      height: 95vh;
      border-radius: 12px;
    }

    .calendly-modal-close {
      top: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
    }
  }

  /* Hide body scroll when modal is open */
  body.calendly-modal-open {
    overflow: hidden;
  }
</style>

<!-- Modal HTML -->
<div class="calendly-modal-overlay" id="calendlyModal">
  <div class="calendly-modal-container">
    <button class="calendly-modal-close" id="calendlyCloseBtn" aria-label="Close scheduling modal">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
      </svg>
    </button>
    <div class="calendly-modal-loading" id="calendlyLoading">
      <div class="calendly-modal-spinner"></div>
      <p style="color: #666; font-size: 14px;">Loading scheduling...</p>
    </div>
    <iframe
      class="calendly-modal-iframe"
      id="calendlyIframe"
      frameborder="0"
      allow="geolocation; microphone; camera"
    ></iframe>
  </div>
</div>

<script>
  (function () {
    const DEFAULT_CALENDLY_URL =
      'https://calendly.com/bellesperformancetennis-sales/racquet_service';
    const EMBED_PARAMS = '?embed_domain=www.bellesperformancetennis.com&embed_type=Inline';

    /*
      Touch layouts skip the modal entirely and navigate straight to
      Calendly. Decided 2026-09-08 by the site owner, who set the priority
      explicitly: the scheduler has to be the fastest thing on the site,
      even at a cost to PageSpeed.

      Why direct navigation is faster than any preload we could write: the
      modal loads Calendly's EMBED bundle (~2.5MB) into an iframe on top of
      an already-loaded page. Navigating hits Calendly's own standalone
      booking page, which is far smaller and is the thing Calendly actually
      optimizes. There is no preload strategy that beats not loading it.

      This targets the measured problem. Over Aug 11 - Sep 7 2026, GA4 shows
      22 users reaching the Calendly page, 5 picking a day, 4 booking. Once
      someone picks a day they nearly always finish, so effectively all of
      the loss sits at the first step, which is exactly where the 4-5 second
      blank spinner on a cold mobile tap lives (see CLAUDE.md).

      Desktop keeps the modal: it holds the visitor in context on a large
      screen, and desktop is where the hover preload actually gets a chance
      to run before the click.

      OR rather than AND on purpose. A narrow window on a desktop and a
      tablet in landscape are both cases where the modal's only real benefit
      (staying in context on a big screen) does not apply. Fails open to the
      modal, which works everywhere.
    */
    var IS_TOUCH_LAYOUT = (function () {
      try {
        return window.matchMedia('(pointer: coarse)').matches ||
               window.matchMedia('(max-width: 768px)').matches;
      } catch (err) {
        return false;
      }
    })();

    const modal = document.getElementById('calendlyModal');
    const iframe = document.getElementById('calendlyIframe');
    const loading = document.getElementById('calendlyLoading');
    const closeBtn = document.getElementById('calendlyCloseBtn');

    let currentCalendlyUrl = '';

    // Function to hide loading and show iframe
    function showIframe() {
      if (loading) loading.style.display = 'none';
      if (iframe) iframe.style.display = 'block';
    }

    // Build the embed URL from a Calendly link
    function buildEmbedUrl(href) {
      if (href && href.indexOf('calendly.com') !== -1) {
        // Strip any existing query params and add embed params
        var base = href.split('?')[0];
        return base + EMBED_PARAMS;
      }
      return DEFAULT_CALENDLY_URL + EMBED_PARAMS;
    }

    var isPreloaded = false;
    var isOpen = false;
    var lastSource = '';

    /*
      Guards against double counting the conversion.

      Calendly posts calendly.event_scheduled from inside its iframe, and it
      does not guarantee posting it exactly once. Verified live on
      2026-09-07: a single completed booking produced TWO
      calendly_event_scheduled events in GA4. The theme only attaches one
      message listener and the snippet is rendered once, so the duplicate
      came from Calendly, not from us.

      One modal session can only produce one booking, so the conversion is
      emitted at most once per open. Reset in openModal.
    */
    var scheduledTracked = false;

    /*
      Booking analytics.

      This store loads GA4 through Shopify's Customer Events web pixel, not
      through a gtag snippet in the theme, so window.gtag and window.dataLayer
      do NOT exist in page context. Verified: both appear zero times in the
      rendered HTML while G-SKJK8YPREK appears twelve. Calling gtag() directly
      here would fail silently and look like it worked.

      So we publish through Shopify.analytics.publish, which is the supported
      way for theme code to emit an event that a Customer Events pixel can
      subscribe to. gtag and dataLayer are still attempted in case either is
      ever added, and every path is optional.

      Costs nothing on page load. No script is fetched, nothing runs until a
      visitor actually clicks a booking button, which keeps this clear of the
      Calendly preload rule in CLAUDE.md.

      IMPORTANT: publishing alone does not put anything in GA4. A custom pixel
      in Shopify Admin has to subscribe to these two event names and forward
      them. Until that exists this is emitting into the void, by design, so
      the theme side is ready and safe either way.
    */
    function readUtmContent(url) {
      try {
        var m = /[?&]utm_content=([^&#]*)/.exec(url || '');
        return m ? decodeURIComponent(m[1]) : 'unknown';
      } catch (err) {
        return 'unknown';
      }
    }

    function trackCalendly(eventName, params) {
      var payload = params || {};
      try {
        if (window.Shopify && window.Shopify.analytics &&
            typeof window.Shopify.analytics.publish === 'function') {
          window.Shopify.analytics.publish(eventName, payload);
        }
      } catch (err) { /* analytics must never break booking */ }
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, payload);
        }
      } catch (err) { /* no-op */ }
      try {
        if (window.dataLayer && typeof window.dataLayer.push === 'function') {
          var dl = { event: eventName };
          for (var k in payload) {
            if (Object.prototype.hasOwnProperty.call(payload, k)) dl[k] = payload[k];
          }
          window.dataLayer.push(dl);
        }
      } catch (err) { /* no-op */ }
    }

    // Preload the default Calendly URL in the background. Two triggers now:
    // first sign of intent (hover/focus on a trigger), and on desktop also
    // once the page has finished painting, see schedulePreload below.
    function preloadCalendly() {
      if (isPreloaded || !iframe || IS_TOUCH_LAYOUT) return;
      isPreloaded = true;
      iframe.src = DEFAULT_CALENDLY_URL + EMBED_PARAMS;
      currentCalendlyUrl = DEFAULT_CALENDLY_URL + EMBED_PARAMS;
      iframe.addEventListener('load', function() {
        if (loading) loading.style.display = 'none';
        if (iframe) iframe.style.display = 'block';
      }, { once: true });
    }

    /*
      Desktop-only warm-up after the page has finished painting.

      READ THIS BEFORE REVERTING. CLAUDE.md carries a rule against any
      page-load-triggered Calendly preload, because two previous attempts
      regressed PageSpeed and were reverted (0c51e5c on DOMContentLoaded,
      23efcce on a 1.5s timer plus requestIdleCallback). That rule was
      written when PageSpeed was the thing being optimized. On 2026-09-08
      the owner changed the priority: booking speed wins over PageSpeed.
      This is a deliberate, informed override of that rule, not a
      regression, and CLAUDE.md has been updated to match. Do not quietly
      revert it back to hover-only.

      Two things keep the cost contained:

      1. Desktop only. Mobile never reaches here because IS_TOUCH_LAYOUT
         short-circuits preloadCalendly, so the mobile PageSpeed run, which
         is the one that scores badly and throttles hardest, is untouched.
      2. Hooked to the load event, not a timer. load fires after the hero
         background image has been fetched, so the Calendly bundle is never
         competing with the LCP element for bandwidth. The two rAFs push it
         past the paint that follows. A timer could not make that promise,
         which is part of why 23efcce failed.

      The hover/focus preload stays as well. It usually wins the race on
      desktop, and this is the backstop for anyone who clicks without ever
      hovering, for example via keyboard or a trackpad tap.
    */
    function schedulePreload() {
      if (IS_TOUCH_LAYOUT) return;
      function start() {
        requestAnimationFrame(function () {
          requestAnimationFrame(preloadCalendly);
        });
      }
      if (document.readyState === 'complete') {
        start();
      } else {
        window.addEventListener('load', start, { once: true });
      }
    }

    // Open modal
    function openModal(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      if (!modal || isOpen) return;
      isOpen = true;

      // Visual feedback on the clicked button
      if (e && e.currentTarget) {
        var btn = e.currentTarget;
        var originalText = btn.textContent || btn.innerText;
        btn.style.opacity = '0.7';
        btn.style.pointerEvents = 'none';
        setTimeout(function() {
          btn.style.opacity = '';
          btn.style.pointerEvents = '';
        }, 3000);
      }

      // Get the Calendly URL from the clicked element's original href
      var targetUrl = DEFAULT_CALENDLY_URL;
      if (e && e.currentTarget && e.currentTarget.dataset.calendlyUrl) {
        targetUrl = e.currentTarget.dataset.calendlyUrl;
      }
      var embedUrl = buildEmbedUrl(targetUrl);

      lastSource = readUtmContent(targetUrl);
      scheduledTracked = false;
      trackCalendly('calendly_modal_open', {
        booking_source: lastSource,
        page_path: window.location.pathname
      });

      modal.classList.add('active');
      document.body.classList.add('calendly-modal-open');

      if (iframe) {
        // If we already preloaded this URL, show immediately
        if (currentCalendlyUrl === embedUrl && isPreloaded) {
          if (loading) loading.style.display = 'none';
          iframe.style.display = 'block';
        } else {
          // Different URL or not yet preloaded, load now with spinner
          if (loading) loading.style.display = 'block';
          iframe.style.display = 'none';
          iframe.src = embedUrl;
          currentCalendlyUrl = embedUrl;
          iframe.addEventListener('load', showIframe, { once: true });
          setTimeout(showIframe, 3000);
        }
      }
    }

    // Close modal
    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      document.body.classList.remove('calendly-modal-open');
      isOpen = false;
    }

    // Close button click
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    // Click outside modal to close
    if (modal) {
      modal.addEventListener('click', function (e) {
        if (e.target === modal) {
          closeModal();
        }
      });
    }

    // Escape key to close
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Listen for Calendly events
    // Listen for Calendly events
    window.addEventListener('message', function (e) {
      if (e.data && e.data.event && typeof e.data.event === 'string' && e.data.event.indexOf('calendly') === 0) {
        if (e.data.event === 'calendly.page_height' || e.data.event === 'calendly.event_type_viewed') {
          showIframe();
        }
        if (e.data.event === 'calendly.event_scheduled') {
          // The actual conversion, not just intent. Calendly posts this
          // from inside the iframe once a booking is confirmed, but it can
          // post it more than once, so this is emitted at most once per
          // modal open. See the scheduledTracked comment above.
          if (!scheduledTracked) {
            scheduledTracked = true;
            trackCalendly('calendly_event_scheduled', {
              booking_source: lastSource,
              page_path: window.location.pathname
            });
          }
          // Closing stays outside the guard: a repeat post should still
          // close the modal even though it must not re-count.
          setTimeout(closeModal, 2000);
        }
      }
    });

    /*
      Touch-layout click handler. No modal, no preventDefault on anchors:
      the browser follows href to Calendly, which is the whole point.

      Still publishes calendly_modal_open, deliberately keeping the same
      event name as the desktop modal so the GA4 metric stays continuous
      across this change. It now means "clicked to book" on both paths
      rather than literally "a modal opened".

      That publish is best effort. Navigation can cut it off, so some taps
      will not be recorded. Acceptable, because the conversion of record is
      invitee_meeting_scheduled, which Calendly fires from its own page and
      which is unaffected by any of this. Booking source attribution also
      survives, since the UTM params ride along in the URL we navigate to.
    */
    function handleDirectBooking(e) {
      var trigger = e && e.currentTarget;
      if (!trigger) return;

      var targetUrl = (trigger.dataset && trigger.dataset.calendlyUrl) || DEFAULT_CALENDLY_URL;

      trackCalendly('calendly_modal_open', {
        booking_source: readUtmContent(targetUrl),
        page_path: window.location.pathname
      });

      // Anchors navigate themselves via href. Anything else (a button with
      // data-calendly-modal) has no href to follow and needs a push.
      if (trigger.tagName !== 'A') {
        e.preventDefault();
        window.location.href = targetUrl;
      }
    }

    // Function to attach click handlers to calendly triggers
    function attachCalendlyTriggers() {
      // Find all links that either have the data attribute OR contain calendly.com in href
      const triggers = document.querySelectorAll('[data-calendly-modal="true"], a[href*="calendly.com"]');

      triggers.forEach(function (trigger) {
        // Skip if already processed
        if (trigger.dataset.calendlyProcessed) return;

        // Mark as processed
        trigger.dataset.calendlyProcessed = 'true';

        // Preserve the original Calendly URL before overwriting href
        if (trigger.tagName === 'A' && trigger.getAttribute('href') && trigger.getAttribute('href').indexOf('calendly.com') !== -1) {
          trigger.dataset.calendlyUrl = trigger.getAttribute('href');
        }

        if (IS_TOUCH_LAYOUT) {
          /*
            Navigation is the entire mechanism here, so href has to be a real
            Calendly URL or the button does nothing. Two triggers rely on the
            fallback: the else branch in belle-city-hero.liquid, which ships
            href="#" by design, and any button-tag trigger, which never had an
            href at all. Both get the default booking URL.
          */
          if (trigger.tagName === 'A') {
            trigger.setAttribute('href', trigger.dataset.calendlyUrl || DEFAULT_CALENDLY_URL);
          }
          trigger.addEventListener('click', handleDirectBooking);
          return;
        }

        // Hover/focus preload, so by the time the user actually clicks,
        // Calendly is already warm. touchstart is gone from this branch on
        // purpose: a coarse pointer is a touch layout and never gets here.
        trigger.addEventListener('pointerenter', preloadCalendly, { once: true });
        trigger.addEventListener('focus', preloadCalendly, { once: true });

        // Remove existing click handlers and add our handler
        trigger.addEventListener('click', openModal);

        // Restore the real Calendly URL onto href so the link still works
        // if scripting is unavailable. Guarded: a trigger with no
        // dataset.calendlyUrl (a button whose href was never a calendly.com
        // link) used to get the literal string "undefined" written into
        // href, turning it into a 404 instead of leaving it alone.
        if (trigger.tagName === 'A' && trigger.dataset.calendlyUrl) {
          trigger.setAttribute('href', trigger.dataset.calendlyUrl);
        }
      });
    }

    // Run when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachCalendlyTriggers);
    } else {
      attachCalendlyTriggers();
    }

    // Desktop warm-up, no-ops on touch layouts. See schedulePreload.
    schedulePreload();

    // Also run after a short delay to catch any dynamically added elements
    setTimeout(attachCalendlyTriggers, 500);

    // And observe for new elements being added to the DOM
    if (typeof MutationObserver !== 'undefined') {
      const observer = new MutationObserver(function (mutations) {
        let shouldReattach = false;
        mutations.forEach(function (mutation) {
          if (mutation.addedNodes.length > 0) {
            shouldReattach = true;
          }
        });
        if (shouldReattach) {
          attachCalendlyTriggers();
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });
    }
  })();
</script>
